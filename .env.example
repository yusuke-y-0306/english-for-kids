# 認証まわりの環境変数 (issue #23 ログイン機能)
#
# 生成: npm run auth:keygen
# 設定先: 開発なら .env.local / 本番なら systemd の EnvironmentFile
#        (例: ~/.config/english-for-kids/auth.env, パーミッション 600)

# ユーザーの「秘密」(保護者パスフレーズ) を暗号化する鍵。base64 で 32 バイト。
# 変更すると保存済みの秘密は復号できなくなる。
USERPOOL_MASTER_KEY=

# セッション cookie の署名鍵 (32 文字以上)
SESSION_SECRET=

# 2 人目以降の子どもを追加するときの管理者パスフレーズ。
# 未設定の場合、ユーザーが 1 人もいないときの初期登録だけが可能。
GUARDIAN_ADMIN_PASSPHRASE=

# WebAuthn の RP ID / オリジン。
# 本番ドメインが決まったら必ず固定する (例: eigo.example.com / https://eigo.example.com)。
# 未設定ならリクエストのホストから推測する (開発・一時トンネル用)。
# 注意: RP ID が変わると、それ以前に登録した生体認証は使えなくなる。
WEBAUTHN_RP_ID=
WEBAUTHN_ORIGIN=
WEBAUTHN_RP_NAME=こども英語ひろば

# データ置き場 (既定: <repo>/data)
# AUTH_DATA_DIR=
